# Production defaults to GitHub. Local development defaults to ./content.
# Set BLOG_CONTENT_SOURCE=github locally to exercise the remote source.
BLOG_CONTENT_SOURCE=<github-or-local>
GITHUB_CONTENT_REPOSITORY=<github-owner>/<github-repository>
GITHUB_CONTENT_BRANCH=<branch-name>

# Optional: increases GitHub API rate limits. Keep this server-only value out of client variables.
# GITHUB_TOKEN=
